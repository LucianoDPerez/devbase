# Enforce LF everywhere it matters: gofmt flags CRLF, and shell scripts
# must stay LF for git-bash/MSYS. Windows-only files keep CRLF.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
